{% extends "base.html.j2" %}
{% block css %}.G{grid-template-columns:1fr 1fr}{% endblock %}
{% block body %}
{% set p = d.pick %}
<div style="padding:56px 48px 0;display:flex;flex-direction:column;gap:36px">
 <div style="font-size:40px;font-weight:700" class="muted">{{ d.pick_headline }}</div>
 <div style="display:flex;align-items:center;gap:36px">
  <div style="background:#FFD400;color:#082779;font-size:150px;font-weight:900;padding:6px 40px;border-radius:12px;line-height:1.15">{{ p.code }}</div>
  <div><div style="font-size:72px;font-weight:900">{{ p.name }}</div><div style="font-size:52px;font-weight:900" class="{{ p.verdict_cls }}">{{ p.verdict }}</div></div>
 </div>
 <div style="font-size:96px;font-weight:900;line-height:1.1">{{ p.today_s }}원 <span style="font-size:40px;font-weight:500" class="muted">/ {{ p.unit_label }}</span></div>
</div>
<div style="margin-top:40px">
 <div class="row G" style="height:104px"><div style="font-size:34px;font-weight:500">30일 평균</div><div class="r" style="font-size:40px;font-weight:700">{{ p.avg_s }}원</div></div>
 <div class="row G" style="height:104px"><div style="font-size:34px;font-weight:500">30일 중 위치</div><div class="r {{ p.verdict_cls }}" style="font-size:40px;font-weight:700">{{ p.pos_s }}</div></div>
 <div class="row G" style="height:104px"><div style="font-size:34px;font-weight:500">어제 대비</div><div class="r {{ p.delta_cls }}" style="font-size:40px;font-weight:700">{{ p.delta_long_s }}</div></div>
 <div class="row G" style="height:104px"><div style="font-size:34px;font-weight:500">{{ p.travel_label }} 살 때 (100% 우대)</div><div class="r" style="font-size:40px;font-weight:700">{{ p.travel_best_s }}원</div></div>
</div>
{% endblock %}
{% block foot %}최근 {{ d.pick.n }}영업일 데이터 기준 · 환율 예측 아님{% endblock %}
